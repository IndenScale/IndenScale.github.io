#!/bin/bash

# Default values
SOURCE_DIR=""
RECURSIVE=false
OUTPUT_FILE=""

show_help() {
    echo "Usage: $0 -d <dir> [-r] [-o <output_file>]"
    echo ""
    echo "Options:"
    echo "  -d, --dir <dir>       Source directory to search for .md files (Required)"
    echo "  -r, --recursive       Enable recursive search (DFS) for .md files"
    echo "  -o, --output <file>   Output file path (Default: <dir>/.tmp)"
    echo "  -h, --help            Show this help message"
}

# Parse arguments
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -d|--dir) SOURCE_DIR="$2"; shift ;;
        -r|--recursive) RECURSIVE=true ;;
        -o|--output) OUTPUT_FILE="$2"; shift ;;
        -h|--help) show_help; exit 0 ;;
        *) echo "Unknown parameter: $1"; show_help; exit 1 ;;
    esac
    shift
done

# Validate required parameters
if [ -z "$SOURCE_DIR" ]; then
    echo "Error: Source directory (-d) is required."
    show_help
    exit 1
fi

if [ ! -d "$SOURCE_DIR" ]; then
    echo "Error: Directory '$SOURCE_DIR' does not exist."
    exit 1
fi

# Set default output file if not provided
if [ -z "$OUTPUT_FILE" ]; then
    # Remove trailing slash if exists
    CLEAN_DIR="${SOURCE_DIR%/}"
    OUTPUT_FILE="$CLEAN_DIR/.tmp"
fi

# Clear or create the output file
> "$OUTPUT_FILE"

# Prepare find command
FIND_CMD="find \"$SOURCE_DIR\" -name \"*.md\" -type f"
if [ "$RECURSIVE" = false ]; then
    FIND_CMD="$FIND_CMD -maxdepth 1"
fi

echo "Concatenating .md files from $SOURCE_DIR..."
if [ "$RECURSIVE" = true ]; then
    echo "Recursive mode enabled."
fi
echo "Output path: $OUTPUT_FILE"

# Convert relative output path to absolute for comparison
ABS_OUTPUT=$(mkdir -p "$(dirname "$OUTPUT_FILE")" && cd "$(dirname "$OUTPUT_FILE")" && pwd)/$(basename "$OUTPUT_FILE")

# Use find and sort to get a stable DFS order
# We use a temporary file to store the list to avoid issues with spaces in filenames
TEMP_LIST=$(mktemp)
eval "$FIND_CMD" | sort > "$TEMP_LIST"

FILE_COUNT=0
while IFS= read -r file; do
    # Skip the output file itself if it's in the search path
    ABS_FILE=$(cd "$(dirname "$file")" && pwd)/$(basename "$file")
    if [ "$ABS_FILE" = "$ABS_OUTPUT" ]; then
        continue
    fi

    filename=$(basename "$file")
    echo "Appending $file..."
    echo "<!-- BEGIN FILE: $file -->" >> "$OUTPUT_FILE"
    cat "$file" >> "$OUTPUT_FILE"
    echo -e "\n\n<!-- END FILE: $file -->\n" >> "$OUTPUT_FILE"
    ((FILE_COUNT++))
done < "$TEMP_LIST"

rm "$TEMP_LIST"

echo "Done. $FILE_COUNT files concatenated into $OUTPUT_FILE."
